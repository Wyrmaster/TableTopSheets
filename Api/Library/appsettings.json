{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Authentication": {
    "Provider": "Database",
    "Jwt": {
      "Issuer": "TableTopSheets",
      "Audience": "TableTopSheets",
      "SigningKey": "",
      "Lifetime": "08:00:00"
    },
    "Database": {
      "MinimumPasswordLength": 8,
      "AllowRegistration": true
    },
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "UserNameClaim": "preferred_username",
      "EmailClaim": "email"
    }
  },
  "ConnectionStrings": {
  }
}
