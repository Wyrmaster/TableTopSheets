<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ruleset migrator: applies the EF migrations and writes the rules seed (a mounted folder, dnddata/ in the repository) into the database.
    Runs as its own process (docker: the "migrator" service, before the API); the tests use it as a library
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>TableTopSheets.Seed.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Library\TableTopSheets.Engine.csproj" />
    <ProjectReference Include="..\Persistence\Sqlite\TableTopSheets.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\Persistence\Postgresql\TableTopSheets.Persistence.Postgresql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

</Project>
