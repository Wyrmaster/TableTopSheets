          "features": [
            {
              "key": "fiend-patron.fiend-spells",
              "name": "Fiend Spells",
              "level": 3,
              "description": "<p>The magic of your patron ensures you always have certain spells ready; when you reach a Warlock level specified in the Fiend Spells table, you thereafter always have the listed spells prepared.</p>",
              "effects": [
                {
                  "target": "spell.burning-hands",
