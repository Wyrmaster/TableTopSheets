        {
          "key": "eldritch-knight",
          "name": "Eldritch Knight",
          "scales": {
            "eldritch-knight.cantrips": "0,0,2,2,2,2,2,2,2,3,3,3,3,3,3,3,3,3,3,3",
            "eldritch-knight.prepared": "0,0,3,4,4,4,5,6,6,7,8,8,9,10,10,11,11,11,12,13"
          },
          "features": [
            {
              "key": "eldritch-knight.spellcasting",
              "name": "Spellcasting",
              "level": 3,
              "description": "<p>You have learned to cast spells. You know two Wizard cantrips and prepare Wizard spells as shown in the Eldritch Knight Spellcasting table. Intelligence is your spellcasting ability. Whenever you gain a Fighter level, you can replace one cantrip and one prepared spell.</p>",
              "spellcasting": {
                "ability": "int",
                "progression": "Third",
                "slotTable": "eldritch-knight",
                "spellList": "wizard",
                "prepared": "eldritch-knight.prepared",
                "cantrips": "eldritch-knight.cantrips",
                "class": "fighter",
                "pool": "ClassList",
                "prepareChange": "LevelUp",
                "ritual": "None",
                "focus": "Arcane Focus"
              },
              "choices": [
                {
                  "key": "eldritch-knight.cantrips",
                  "name": "Cantrips",
                  "count": "scale('eldritch-knight.cantrips')",
                  "source": "Spell",
                  "replace": "OneOnLevelUp",
                  "filter": "onList('wizard') && option.level == 0",
                  "category": "cantrip"
                },
                {
                  "key": "eldritch-knight.prepared",
                  "name": "Prepared Spells",
                  "count": "scale('eldritch-knight.prepared')",
                  "source": "Spell",
                  "replace": "OneOnLevelUp",
                  "filter": "onList('wizard') && option.level >= 1 && option.level <= maxSpellLevel('fighter')",
                  "category": "prepared"
                }
              ]
            },
            {
              "key": "eldritch-knight.war-bond",
              "name": "War Bond",
              "level": 3,
              "description": "<p>You can bond with up to two weapons; you can’t be disarmed of a bonded weapon and can summon it to your hand as a Bonus Action.</p>"
            },
            {
              "key": "eldritch-knight.war-magic",
              "name": "War Magic",
              "level": 7,
              "description": "<p>When you take the Attack action, you can replace one of the attacks with a casting of one of your Wizard cantrips that has a casting time of an action.</p>"
            },
            {
              "key": "eldritch-knight.eldritch-strike",
              "name": "Eldritch Strike",
              "level": 10,
              "description": "<p>When you hit a creature with an attack using a weapon, that creature has Disadvantage on the next saving throw it makes against a spell you cast before the end of your next turn.</p>"
            },
            {
              "key": "eldritch-knight.arcane-charge",
              "name": "Arcane Charge",
              "level": 15,
              "description": "<p>When you use Action Surge, you can teleport up to 30 feet to an unoccupied space you can see.</p>"
            },
            {
              "key": "eldritch-knight.improved-war-magic",
              "name": "Improved War Magic",
              "level": 18,
              "description": "<p>When you take the Attack action, you can replace two of the attacks with a casting of one of your level 1 or 2 Wizard spells that has a casting time of an action.</p>"
            }
          ]
        }
