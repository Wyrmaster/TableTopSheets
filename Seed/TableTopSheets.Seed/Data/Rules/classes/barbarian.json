                        "sheetSection": "Hidden",
                        "effects": [
                          {
                            // added after a species' Set, so 60 feet or 60 feet more
                            "target": "sense.darkvision",
                            "op": "Add",
                            "value": "60",
                            "label": "Aspect of the Wilds (Owl)"
                          }
                        ]
                      }
                    },
                    {
                      "key": "panther",
                      "name": "Panther",
                      "feature": {
                        "key": "path-of-the-wild-heart.aspect-of-the-wilds.panther",
                        "sheetSection": "Hidden",
                        "effects": [
                          {
                            "target": "speed.climb",
                            "op": "Set",
                            "value": "stat('speed.walk')",
                            "label": "Aspect of the Wilds (Panther)"
                          }
                        ]
                      }
                    },
                    {
                      "key": "salmon",
                      "name": "Salmon",
                      "feature": {
                        "key": "path-of-the-wild-heart.aspect-of-the-wilds.salmon",
                        "sheetSection": "Hidden",
                        "effects": [
                          {
                            "target": "speed.swim",
