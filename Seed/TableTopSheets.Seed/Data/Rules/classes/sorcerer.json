            {
              "key": "draconic-sorcery.elemental-affinity",
              "name": "Elemental Affinity",
              "level": 6,
              "description": "<p>Choose one damage type: Acid, Cold, Fire, Lightning, or Poison. You have Resistance to that damage type, and when you cast a spell that deals damage of that type, you can add your Charisma modifier to one damage roll of that spell.</p>",
              "choices": [
