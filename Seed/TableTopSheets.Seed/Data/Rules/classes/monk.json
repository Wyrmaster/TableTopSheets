        {
          "key": "warrior-of-the-open-hand",
          "name": "Warrior of the Open Hand",
          "features": [
            {
              "key": "warrior-of-the-open-hand.open-hand-technique",
              "name": "Open Hand Technique",
              "level": 3,
              "description": "<p>Whenever you hit a creature with an attack granted by your Flurry of Blows, you can impose one of the following effects on that target: Addle, Push, or Topple.</p>"
            },
            {
              "key": "warrior-of-the-open-hand.wholeness-of-body",
              "name": "Wholeness of Body",
              "level": 6,
              "description": "<p>As a Bonus Action, you can roll your Martial Arts die and regain Hit Points equal to the number rolled plus your Wisdom modifier. Uses equal to your Wisdom modifier per Long Rest.</p>",
              "resources": [
                {
                  "key": "wholeness-of-body",
                  "name": "Wholeness of Body",
                  "max": "max(1, mod('wis'))",
                  "die": "scale('monk.martial-arts')"
                }
              ]
            },
            {
              "key": "warrior-of-the-open-hand.fleet-step",
              "name": "Fleet Step",
              "level": 11,
              "description": "<p>When you take a Bonus Action other than Step of the Wind, you can also use Step of the Wind immediately after that Bonus Action.</p>"
            },
            {
              "key": "warrior-of-the-open-hand.quivering-palm",
              "name": "Quivering Palm",
              "level": 17,
              "description": "<p>You gain the ability to set up lethal vibrations in someone’s body (4 Focus Points, Constitution save, 10d12 Force damage).</p>"
            }
          ]
        }
