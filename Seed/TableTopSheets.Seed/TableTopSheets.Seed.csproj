<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ruleset migrator: applies the EF migrations and writes the rules seed (Data/**/*.json) into the database.
    Runs as its own process (docker: the "migrator" service, before the API); the tests use it as a library
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>TableTopSheets.Seed.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engine\TableTopSheets.Engine\TableTopSheets.Engine.csproj" />
    <ProjectReference Include="..\..\Persistence\TableTopSheets.Persistence.Sqlite\TableTopSheets.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Persistence\TableTopSheets.Persistence.Postgresql\TableTopSheets.Persistence.Postgresql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
    <None Include="Data\Images\**\*.webp" CopyToOutputDirectory="PreserveNewest" LinkBase="Data\Images" />
  </ItemGroup>

</Project>
