    {
      "key": "gnome",
      "features": [
        {
          "key": "gnome.gnomish-lineage",
          "choices": [
            {
              "key": "gnome.gnomish-lineage",
              "name": "Gnomish Lineage",
              "count": "1",
              "source": "Static",
              "replace": "Never",
              "options": [
                {
                  "key": "forest-gnome",
                  "name": "Forest Gnome",
                  "feature": {
                    "key": "gnome.lineage.forest-gnome",
                    "name": "Forest Gnome Lineage",
                    "description": "<p>You know the <em>Minor Illusion</em> cantrip. You also always have the <em>Speak with Animals</em> spell prepared. You can cast it without a spell slot a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest. You can also use any spell slots you have to cast the spell.</p>",
                    "sheetSection": "SpeciesTraits",
                    "effects": [
                      {
                        "target": "spell.minor-illusion",
                        "op": "Grant",
                        "value": "1",
                        "label": "Forest Gnome"
                      },
                      {
                        "target": "spell.speak-with-animals",
                        "op": "Grant",
                        "value": "1",
                        "label": "Forest Gnome"
                      }
                    ],
                    "resources": [
                      {
                        "key": "forest-gnome.speak-with-animals",
                        "name": "Speak with Animals",
                        "max": "pb",
                        "recharge": "LongRest"
                      }
                    ]
                  }
                },
                {
                  "key": "rock-gnome",
                  "name": "Rock Gnome",
                  "feature": {
                    "key": "gnome.lineage.rock-gnome",
                    "name": "Rock Gnome Lineage",
                    "description": "<p>You know the <em>Mending</em> and <em>Prestidigitation</em> cantrips. In addition, you can spend 10 minutes casting <em>Prestidigitation</em> to create a Tiny clockwork device (AC 5, 1 HP), such as a toy, fire starter, or music box. When you create the device, you determine its function by choosing one effect from <em>Prestidigitation</em>; the device produces that effect whenever you or another creature takes a Bonus Action to activate it with a touch. You can have three such devices in existence at a time, and each falls apart 8 hours after its creation or when you dismantle it with a touch as a Utilize action.</p>",
                    "sheetSection": "SpeciesTraits",
                    "effects": [
                      {
                        "target": "spell.mending",
                        "op": "Grant",
                        "value": "1",
                        "label": "Rock Gnome"
                      },
                      {
                        "target": "spell.prestidigitation",
                        "op": "Grant",
                        "value": "1",
                        "label": "Rock Gnome"
                      }
                    ]
                  }
                }
              ]
