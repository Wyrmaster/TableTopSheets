# copy to .env next to the compose files; docker compose reads it automatically

# host port of the API (Swagger UI at http://localhost:5180/swagger)
API_PORT=5180
ASPNETCORE_ENVIRONMENT=Production

# Database | Oidc
AUTH_PROVIDER=Database
# at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=
ALLOW_REGISTRATION=true
OIDC_AUTHORITY=
OIDC_AUDIENCE=

# compose.postgresql.yaml
POSTGRES_DB=tabletopsheets
POSTGRES_USER=tabletopsheets
POSTGRES_PASSWORD=tabletopsheets
POSTGRES_PORT=5432

# compose.postgresql-external.yaml
POSTGRES_CONNECTION=Host=host.docker.internal;Port=5432;Database=tabletopsheets;Username=postgres;Password=
